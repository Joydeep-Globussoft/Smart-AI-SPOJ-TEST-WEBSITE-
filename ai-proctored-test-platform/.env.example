# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.vercel.app
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# MongoDB Atlas / Cloud MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai_proctored_test_platform?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=your_production_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Judge0 Code Execution Service (PRD Section 5 & 9.5)
# Set JUDGE0_API_URL or JUDGE0_URL to your deployed Judge0 instance (e.g., Docker container on Render/AWS or RapidAPI)
# Option A: Self-hosted Judge0 instance (Render / AWS / VPS)
JUDGE0_API_URL=https://your-judge0-instance.onrender.com
JUDGE0_API_KEY=your_optional_auth_token_here

# Option B: RapidAPI Judge0 CE (https://rapidapi.com/judge0-official/api/judge0-ce)
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here

# Option C: Local Development Docker Container
# JUDGE0_API_URL=http://localhost:2358

# Kimi LLM (self-hosted / cloud proxy)
KIMI_API_BASE_URL=
KIMI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YOLO phone-detection microservice
YOLO_SERVICE_URL=http://localhost:8001/detect

# Candidate account expiry (in days)
CANDIDATE_ACCOUNT_EXPIRY_DAYS=3

# Socket.io CORS
SOCKET_CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Client Frontend (.env for Vercel / Vite frontend)
# VITE_API_URL=https://your-backend-domain.onrender.com/api/v1
# VITE_SOCKET_URL=https://your-backend-domain.onrender.com

